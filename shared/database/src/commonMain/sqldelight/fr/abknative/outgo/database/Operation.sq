-- ==========================================
-- ✍️ WRITE (Insert & Update)
-- ==========================================

insertOperation:
INSERT INTO OperationEntity(
    id, userId, walletId, name, amountInCents, type, recurrence, startDate, endDate,
    createdAt, updatedAt, deletedAt, syncStatus
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateOperation:
UPDATE OperationEntity
SET
    walletId = ?,
    name = ?,
    amountInCents = ?,
    type = ?,
    recurrence = ?,
    startDate = ?,
    endDate = ?,
    updatedAt = ?,
    deletedAt = ?,
    syncStatus = ?
WHERE id = ? AND userId = ?;

-- ==========================================
-- 📖 READ (Queries)
-- ==========================================

-- Time engine: Filter by active period
getOperationsByPeriod:
SELECT * FROM OperationEntity
WHERE deletedAt IS NULL
  AND userId = :userId
  AND walletId = :walletId
  AND startDate <= :to
  AND (endDate IS NULL OR endDate >= :from)
ORDER BY startDate ASC;

getOperationById:
SELECT * FROM OperationEntity
WHERE id = ? AND userId = ?;

-- ==========================================
-- 🗑️ DELETE (Soft & Hard)
-- ==========================================

markAsDeleted:
UPDATE OperationEntity
SET deletedAt = ?, syncStatus = 'PENDING_DELETE', updatedAt = ?
WHERE id = ? AND userId = ?;

-- Essential: For cascading soft deletes when a wallet is soft-deleted
softDeleteByWalletId:
UPDATE OperationEntity
SET deletedAt = ?, syncStatus = 'PENDING_DELETE', updatedAt = ?
WHERE walletId = ? AND deletedAt IS NULL AND userId = ?;

-- Security: Hard delete ONLY if it was never synced to the server
hardDeletePendingCreate:
DELETE FROM OperationEntity
WHERE id = ? AND syncStatus = 'PENDING_CREATE' AND userId = ?;

-- Total purge for the current user
deleteAllForUser:
DELETE FROM OperationEntity
WHERE userId = :userId;

-- ==========================================
-- 🔄 SYNC & MIGRATION (Engine)
-- ==========================================

getPendingOperations:
SELECT * FROM OperationEntity
WHERE syncStatus != 'SYNCED' AND userId = :userId;

updateSyncStatus:
UPDATE OperationEntity
SET syncStatus = ?
WHERE id = ? AND userId = ?;

resetAllToPendingCreate:
UPDATE OperationEntity
SET syncStatus = 'PENDING_CREATE', updatedAt = :now
WHERE userId = :userId;

-- Migrates offline local data to a real authenticated account
updateUserId:
UPDATE OperationEntity
SET userId = :newUserId
WHERE userId = :oldUserId;