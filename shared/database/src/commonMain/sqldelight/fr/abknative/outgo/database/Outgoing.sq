/**
 * Inserts a new outgoing expense. Fails if the ID already exists.
 */
insertOutgoing:
INSERT INTO OutgoingEntity(
    id, budgetId, name, amountInCents, recurrence, dueDay, dueMonth,
    createdAt, updatedAt, isDeleted, syncStatus
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

/**
 * Updates an existing outgoing expense by its ID.
 */
updateOutgoing:
UPDATE OutgoingEntity
SET
    name = ?,
    amountInCents = ?,
    recurrence = ?,
    dueDay = ?,
    dueMonth = ?,
    updatedAt = ?,
    isDeleted = ?,
    syncStatus = ?
WHERE id = ?;

/**
 * Retrieves all outgoing expenses filtered by month that are not logically deleted.
 */
getOutgoingsByMonth:
SELECT * FROM OutgoingEntity
WHERE isDeleted = 0 AND (dueMonth IS NULL OR dueMonth = :currentMonth)
ORDER BY dueDay ASC;

/**
 * Performs a soft delete and marks the record for remote synchronization.
 */
markAsDeleted:
UPDATE OutgoingEntity
SET isDeleted = 1,
    syncStatus = 'PENDING_DELETE',
    updatedAt = ?
WHERE id = ?;

/**
 * Retrieves all outgoing expenses with local changes pending server synchronization.
 * Includes CREATED, UPDATED, and DELETED items.
 */
getPendingOutgoings:
SELECT * FROM OutgoingEntity
WHERE syncStatus != 'SYNCED';

/**
 * Updates only the synchronization status of an expense.
 */
updateSyncStatus:
UPDATE OutgoingEntity
SET syncStatus = ?
WHERE id = ?;

/**
 * Hard delete (physical removal).
 * Used for items deleted before being synced or for local cleanup.
 */
deletePhysical:
DELETE FROM OutgoingEntity
WHERE id = ?;

/**
 * Retrieves a specific expense by its ID.
 */
getById:
SELECT * FROM OutgoingEntity
WHERE id = ?;