-- ==========================================
-- ✍️ WRITE (Insert & Update)
-- ==========================================

insertWallet:
INSERT INTO WalletEntity(id, userId, name, createdAt, updatedAt, deletedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateWallet:
UPDATE WalletEntity
SET name = ?,
    updatedAt = ?,
    deletedAt = ?,
    syncStatus = ?
WHERE id = ? AND userId = ?;

-- ==========================================
-- 📖 READ (Queries)
-- ==========================================

getActiveWallets:
SELECT * FROM WalletEntity
WHERE deletedAt IS NULL AND userId = :userId;

getActiveWalletById:
SELECT * FROM WalletEntity
WHERE id = ? AND deletedAt IS NULL AND userId = ?;

getWalletById:
SELECT * FROM WalletEntity
WHERE id = ? AND userId = ?;

-- ==========================================
-- 🗑️ DELETE (Soft & Hard)
-- ==========================================

markAsDeleted:
UPDATE WalletEntity
SET deletedAt = ?, syncStatus = 'PENDING_DELETE', updatedAt = ?
WHERE id = ? AND userId = ?;

-- Security: Hard delete ONLY if it was never synced to the server
hardDeletePendingCreate:
DELETE FROM WalletEntity
WHERE id = ? AND syncStatus = 'PENDING_CREATE' AND userId = ?;

-- Total purge for the current user
deleteAllForUser:
DELETE FROM WalletEntity
WHERE userId = :userId;

-- ==========================================
-- 🔄 SYNC & MIGRATION (Engine)
-- ==========================================

getPendingWallets:
SELECT * FROM WalletEntity
WHERE syncStatus != 'SYNCED' AND userId = :userId;

updateSyncStatus:
UPDATE WalletEntity
SET syncStatus = ?
WHERE id = ? AND userId = ?;

-- Migrates offline local data to a real authenticated account
updateUserId:
UPDATE WalletEntity
SET userId = :newUserId
WHERE userId = :oldUserId;