CREATE TABLE WalletEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    name TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    syncStatus TEXT NOT NULL
);

CREATE INDEX idx_wallet_active ON WalletEntity(userId, deletedAt);
CREATE INDEX idx_wallet_sync ON WalletEntity(userId, syncStatus);