/**
 * Inserts a new budget.
 * We now include timestamps and sync status.
 */
insertBudget:
INSERT INTO BudgetEntity(id, monthlyIncomeInCents, createdAt, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?);

/**
 * Updates an existing budget.
 * Every update must refresh 'updatedAt' and 'syncStatus'.
 */
updateBudget:
UPDATE BudgetEntity
SET monthlyIncomeInCents = ?,
    updatedAt = ?,
    syncStatus = ?
WHERE id = ?;

/**
 * Retrieves a budget by its ID.
 */
getBudgetById:
SELECT * FROM BudgetEntity
WHERE id = ?;

/**
 * Retrieves all budgets that need to be pushed to the server.
 */
getPendingBudgets:
SELECT * FROM BudgetEntity
WHERE syncStatus != 'SYNCED';

/**
 * Simple status update (used after a successful push).
 */
updateSyncStatus:
UPDATE BudgetEntity
SET syncStatus = ?
WHERE id = ?;